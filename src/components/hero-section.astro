---
import Button from "./button.astro";
---

<section
  class="w-full max-w-4xl mx-auto px-7 lg:px-0 mt-16 md:mt-24 lg:mt-32 relative"
>
  <div class="relative">
    <div
      id="ProfilePic"
      class="relative justify-end flex-grow md:flex w-[25%] mb-5"
    >
      <div class="relative z-50 w-full">
        <div class="absolute -bottom-6 -right-6 z-40 w-12 h-12 rounded-full">
          <span
            class="relative z-20 flex items-center justify-center w-full h-full text-2xl border-4 border-white rounded-full dark:border-neutral-950 bg-neutral-100 dark:bg-neutral-900"
          >
            <span
              class="flex items-center justify-center w-full h-full bg-white border border-solid rounded-full dark:bg-neutral-950 border-neutral-300 dark:border-neutral-700"
            >
              👋
            </span>
          </span>
        </div>
        <div class="relative z-30 px-1">
          <img
            src="/assets/images/me.png"
            loading="eager"
            decoding="auto"
            class="relative z-30 w-full md:max-w-md mx-auto dark:-translate-y-0.5 rounded-2xl contrast-120 dark:contrast-100"
            alt="Photo of Abhinay"
          />
        </div>
        <div
          class="absolute bottom-0 right-0 z-20 w-full h-full lg:h-[140px] translate-x-0 -translate-y-px border border-solid rounded-2xl bg-gradient-to-r dark:from-neutral-950 dark:via-black dark:to-neutral-950 from-white via-neutral-50 to-white border-neutral-300 dark:border-neutral-700"
        >
        </div>
      </div>
    </div>
    <h1
      class="mb-5 text-4xl font-bold leading-tight md:text-4xl lg:text-6xl dark:text-white"
    >
      Hello, I'm Abhinay.
    </h1>
    <div class="flex flex-col max-w-2xl">
      <h2 class="font-semibold text-lg text-neutral-600 dark:text-neutral-400">
        Sr. Frontend Engineer | Microfrontends, Workflow Engines & Real-Time Web
      </h2>
      <p class="mb-6 text-base text-neutral-600 dark:text-neutral-400">
        I build scalable frontend systems - focused on the architectural
        decisions that keep complex UIs maintainable as they grow.
      </p>
    </div>
    <div class="flex items-center gap-2">
      <Button
        text="Schedule a meeting"
        link="https://calendar.app.google/T8V2fr9b9mxMGyzAA"
        target="_blank"
      />
      <Button class="btn btn-secondary" text="View Portfolio" link="/work" />
    </div>
  </div>
</section>
