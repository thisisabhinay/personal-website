---
import SquareLine from "./square-line.astro";
---

<div class="absolute w-full overflow-hidden" style="z-index:-1">
  <div class="relative w-full bg-neutral-100 dark:bg-neutral-800">
    <!-- Left half gradient -->
    <div class="absolute top-0 left-0 w-1/2 h-full z-30 pointer-events-none
      bg-gradient-to-tl from-white dark:from-neutral-950 from-50% via-90% to-100%
      via-transparent to-transparent">
    </div>
    <!-- Right half gradient -->
    <div class="absolute top-0 right-0 w-1/2 h-full z-30 pointer-events-none
      bg-gradient-to-tr from-white dark:from-neutral-950 from-50% via-90% to-100%
      via-transparent to-transparent">
    </div>
    <!-- Bottom fade -->
    <div class="absolute bottom-0 left-0 w-full h-1/3 z-30 pointer-events-none
      bg-gradient-to-b from-transparent to-white dark:to-neutral-950">
    </div>
    <!-- Grid lines -->
    <div class="flex flex-col w-full h-full border-t divide-y divide-dashed
      divide-neutral-300 dark:divide-neutral-700 border-neutral-300 dark:border-neutral-900">
      {Array.from({ length: 6 }).map(() => (
        <div class="flex w-full">
          <div class="w-1/2"><SquareLine /></div>
          <div class="w-1/2"><SquareLine /></div>
        </div>
      ))}
    </div>
  </div>
</div>
