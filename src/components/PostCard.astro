---
import TagList from './TagList.astro';

interface Props {
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
  category: string;
  tags?: string[];
  thumbnail?: string;
  contentType?: 'article' | 'video';
}

const { slug, title, description, pubDate, category, tags, thumbnail, contentType = 'article' } = Astro.props;
const isVideo = contentType === 'video';
const hasThumbnail = !!thumbnail || isVideo;
---

<li>
  <a href={`/blog/${slug}`} class="group flex gap-5 items-start">
    <div class="flex-1 min-w-0">
      <h2 class="text-lg font-medium text-zinc-900 dark:text-zinc-100 group-hover:underline decoration-zinc-300 dark:decoration-zinc-600 underline-offset-4 mb-1">
        {title}
      </h2>
      <p class="text-zinc-600 dark:text-zinc-400 text-sm mb-2 line-clamp-2">{description}</p>
      <div class="flex items-center gap-3 text-xs text-zinc-400 uppercase tracking-wider">
        <time datetime={pubDate.toISOString().split('T')[0]}>
          {pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
        </time>
        <span>&middot;</span>
        <span>{category}</span>
        {isVideo && (
          <>
            <span>&middot;</span>
            <span class="normal-case">Video</span>
          </>
        )}
      </div>
    </div>
    {hasThumbnail && (
      <div class="relative flex-shrink-0 w-28 h-20 sm:w-32 sm:h-24 rounded-md overflow-hidden bg-zinc-100 dark:bg-zinc-800">
        {thumbnail && <img src={thumbnail} alt="" class="w-full h-full object-cover" loading="lazy" />}
        {!thumbnail && (
          <div class="w-full h-full flex items-center justify-center">
            <svg class="w-8 h-8 text-zinc-300 dark:text-zinc-600" fill="currentColor" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z" />
            </svg>
          </div>
        )}
        {isVideo && (
          <div class="absolute top-1 right-1 bg-zinc-900/70 dark:bg-zinc-100/20 backdrop-blur-sm rounded p-0.5">
            <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z" />
            </svg>
          </div>
        )}
      </div>
    )}
  </a>
  {tags && tags.length > 0 && <TagList tags={tags} class="mt-2" />}
</li>
