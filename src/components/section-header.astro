---
interface Props {
	heading: string;
	subheading?: string;
}

const { heading, subheading } = Astro.props;
---

<div
  id="SectionHeader"
  class="relative grid grid-cols-1 md:grid-cols-2 gap-7 items-center mb-14"
>
  <div class="flex-col gap-1">
    <h2
      class="text-base font-semibold uppercase tracking-widest text-neutral-500 dark:text-neutral-400"
    >
      {heading}
    </h2>
    <p class="text-sm text-neutral-500 dark:text-neutral-400 mt-1">
      {subheading}
    </p>
  </div>
  <div class="hidden md:block relative w-full pl-5 overflow-x-hidden md:pl-0">
    <div
      class="absolute w-full h-px bg-gradient-to-r from-transparent to-white md:from-white dark:from-transparent dark:to-neutral-950 md:dark:from-neutral-950 md:via-transparent md:dark:via-transparent md:to-neutral-300 md:dark:to-neutral-600"
    >
    </div>
    <div
      class="w-full h-px border-t border-solid border-neutral-300 dark:border-neutral-600"
    >
    </div>
  </div>
</div>
