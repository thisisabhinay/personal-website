---
import ImageTile from "./image-tile.astro";

interface Props {
	name: string;
	description: string;
	slug: string;
	image?: string;
	company: string;
	hrefBase: string;
}

const { name, description, slug, image, hrefBase } = Astro.props;
---

<a
  href={`${hrefBase}/${slug}`}
  class="relative flex flex-col w-full items-stretch group rounded-xl transition-all duration-700 ease-out"
>
  <div class="w-full h-full rounded-xl flex flex-col gap-3">
    <ImageTile
      image={image}
      alt={`${name} project thumbnail`}
      width="800"
      height="450"
      coverSize="h-48 md:h-36"
    />
    <div class="block w-full">
      <div
        class="text-base font-semibold tracking-tight text-neutral-800 hover:text-black dark:text-neutral-100 dark:hover:text-white line-clamp-2"
        title={name}
      >
        {name}
      </div>
      <div class="text-sm text-neutral-600 dark:text-neutral-400 line-clamp-2 mt-1 group-hover:text-neutral-900 dark:group-hover:text-neutral-100">
        {description}
      </div>
    </div>
  </div>
</a>
