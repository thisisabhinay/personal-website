---
import Logo from "../components/logo.astro";
import menus from "../data/menu.json";
---

<!-- This is an invisible div with relative position so that it takes up the height of the menu (because menu is absolute/fixed) -->
<div class="relative w-full h-20 opacity-0 pointer-events-none"></div>
<header data-comp="header" class="absolute top-[var(--wip-h,0px)] z-100 w-full h-20 overflow-visible">
  <div
    class="flex items-center justify-between h-full max-w-5xl pl-6 pr-4 mx-auto border-b border-l-0 border-r-0 border-transparent select-none lg:border-r lg:border-l lg:rounded-b-xl"
  >
    <Logo />
    <div
      data-comp="mobile-menu-bg"
      class="fixed inset-0 z-20 hidden w-screen h-screen duration-300 ease-out bg-white/90 dark:bg-neutral-950/90"
    >
    </div>
    <nav
      class="relative z-30 flex flex-row-reverse justify-start text-sm sm:justify-end text-neutral-500 dark:text-neutral-400 sm:flex-row sm:w-full"
    >
      <div
        data-comp="open-menu-btn"
        class="flex flex-col items-end justify-center w-6 h-6 ml-4 cursor-pointer sm:hidden"
      >
        <svg
          class="w-8 h-8 dark:text-neutral-200"
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path d="M4 8h16M4 16h16"></path>
        </svg>
      </div>
      <div
        data-comp="close-menu-btn"
        class="flex flex-col items-end justify-center hidden w-6 h-6 ml-4 -translate-x-1 cursor-pointer sm:hidden"
      >
        <svg
          class="w-6 h-6 text-neutral-600 dark:text-neutral-200"
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </div>
      <div
        data-comp="nav-menu"
        class="absolute top-full right-0 mt-3 ease-out duration-300 sm:top-auto sm:right-auto sm:mt-0 sm:py-0 z-40 flex-col items-stretch justify-start hidden w-40 h-auto text-sm sm:h-auto sm:relative sm:flex-row sm:flex sm:text-sm sm:w-auto sm:pr-0 sm:pt-0"
      >
        <div
          class="absolute inset-0 block sm:hidden bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-700 rounded-xl"
        >
        </div>
        {
          menus.map((menu) => {
            return (
              <a
                href={menu.url}
                class="relative flex items-center w-full px-5 py-3 font-medium tracking-wide duration-200 ease-out sm:justify-center sm:py-0 sm:mb-0 md:w-auto hover:bg-neutral-50 dark:hover:bg-neutral-800 sm:hover:bg-transparent hover:text-neutral-900 dark:hover:text-white"
              >
                {menu.name}
              </a>
            )
          })
        }
      </div>
      <div
        data-comp="dark-toggle"
        class="relative flex items-center pl-6 ml-4 font-medium tracking-wide cursor-pointer text-neutral-800 group dark:text-white"
      >
        <div
          class="absolute left-0 flex items-center justify-center w-6 h-6 overflow-hidden border-b border-transparent horizon group-hover:border-neutral-600"
        >
          <svg
            class="absolute w-6 h-6 transition duration-700 transform ease"
            data-comp="sun-icon"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
            >
            </path>
          </svg>
          <svg
            class="absolute hidden w-6 h-6 transition duration-700 transform ease"
            data-comp="moon-icon"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
            >
            </path>
          </svg>
        </div>
        <span class="hidden sm:inline-block">
          <span data-comp="day-text" class="ml-2">Day mode</span>
          <span data-comp="night-text" class="hidden ml-2">Night mode</span>
        </span>
      </div>
    </nav>
  </div>
</header>
