---
interface Props {
  tags: string[];
  class?: string;
}

const { tags, class: className = '' } = Astro.props;
---

{tags && tags.length > 0 && (
  <div class={`flex flex-wrap gap-1.5 ${className}`}>
    {tags.map((tag) => (
      <a
        href={`/tag/${tag}`}
        class="text-xs px-2 py-0.5 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-500 hover:bg-zinc-200 dark:hover:bg-zinc-700 hover:text-zinc-700 dark:hover:text-zinc-300 transition-colors"
      >
        {tag}
      </a>
    ))}
  </div>
)}
