---
import ListPosts from "../../components/list-posts.astro";
import PageHeading from "../../components/page-heading.astro";
import Layout from "../../layouts/main.astro";
import { latestPosts } from "../../utils/posts";

export function getStaticPaths() {
	const allYears = [
		...new Set(latestPosts.map((post) => post.data.pubDate.getFullYear())),
	];
	return allYears.map((year) => ({ params: { year: String(year) } }));
}

const { year } = Astro.params;
const currentYear = Number(year);
const allYears = [
	...new Set(latestPosts.map((post) => post.data.pubDate.getFullYear())),
].sort((a, b) => b - a);
const latestYear = allYears[0];
const filteredPosts = latestPosts.filter(
	(post) => post.data.pubDate.getFullYear() === currentYear,
);
---

<Layout title={`Blog — ${year}`} description={`Blog posts from ${year}.`}>
  <section class="relative z-20 max-w-2xl mx-auto my-12 px-7 lg:px-0">
    <PageHeading
      title="Blog"
      description="Dive into my musings on life and tech in my latest posts; a blend of introspection and innovation. Keep an eye out for fresh insights and updates!"
    />

    <div class="flex flex-wrap items-center gap-x-6 gap-y-3 mt-8 mb-6">
      <nav class="flex items-center gap-2" aria-label="Filter posts by year">
        {allYears.map((y) => (
          y === currentYear ? (
            <span class="px-3.5 py-1.5 text-sm font-semibold rounded-full bg-neutral-900 dark:bg-neutral-100 text-white dark:text-neutral-900">
              {y}
            </span>
          ) : (
            <a
              href={y === latestYear ? "/blog" : `/blog/${y}`}
              class="px-3.5 py-1.5 text-sm font-medium rounded-full text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors"
            >
              {y}
            </a>
          )
        ))}
      </nav>

    </div>

    <div>
      <ListPosts posts={filteredPosts} />
    </div>
  </section>
</Layout>
