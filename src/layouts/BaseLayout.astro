---
import SEOHead from '../components/SEOHead.astro';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  publishedDate?: Date;
  image?: string;
}

const { title, description, type, publishedDate, image } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Abhinay Thakur</title>
    <SEOHead title={title} description={description} type={type} publishedDate={publishedDate} image={image} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="alternate" type="application/rss+xml" title="RSS Feed" href="/rss.xml" />
    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme');
        if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="max-w-3xl mx-auto px-6 py-12 bg-zinc-50 dark:bg-zinc-900 text-zinc-900 dark:text-zinc-300 font-sans antialiased selection:bg-zinc-200 dark:selection:bg-zinc-700 transition-colors">
    <header class="mb-16 flex justify-between items-center">
      <nav aria-label="Main navigation" class="flex gap-6 text-sm font-medium text-zinc-500">
        <a href="/" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">Home</a>
        <a href="/blog" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">Blog</a>
        <a href="/about" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">About</a>
      </nav>
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle dark mode"
        class="text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 transition-colors"
      >
        <svg id="sun-icon" class="hidden dark:block w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
        </svg>
        <svg id="moon-icon" class="block dark:hidden w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />
        </svg>
      </button>
    </header>
    <main>
      <slot />
    </main>
    <footer class="mt-20 pt-8 border-t border-zinc-200 dark:border-zinc-800 text-xs text-zinc-400">
      <p>&copy; {new Date().getFullYear()} Abhinay Thakur</p>
    </footer>
    <script is:inline>
      document.getElementById('theme-toggle').addEventListener('click', function() {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });
    </script>
  </body>
</html>
